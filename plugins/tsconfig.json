{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*/**/*.ts"],
  "exclude": [
    "desktop/main.ts",
    "desktop/window.ts",
    "acryl-*/src/**/*.test.ts",
    "acryl-*/src/**/*.case.ts",
    "acryl-node-server/tests/adapter",
    "acryl-router/tests/loader.spec.ts",
    "acryl-state/src/react.ts",
    "acryl-state/tests/react.spec.ts",
    "acryl-router-http/tests/adapter.spec.ts",
    "acryl-router-http/tests/stream.spec.ts",
    "acryl-router-http/tests/surfaces.spec.ts"
  ]
}
