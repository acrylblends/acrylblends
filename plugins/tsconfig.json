{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*/**/*.ts"],
  "exclude": [
    "acryl-router/tests/loader.spec.ts",
    "acryl-state/src/react.ts",
    "acryl-state/tests/react.spec.ts",
    "acryl-router-http/tests/adapter.spec.ts",
    "acryl-router-http/tests/stream.spec.ts",
    "acryl-router-http/tests/surfaces.spec.ts"
  ]
}
