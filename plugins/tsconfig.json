{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "acryl-db": ["./acryl-db/src/index.ts"],
      "acryl-db/cordis": ["./acryl-db/src/cordis.ts"],
      "acryl-db/conformance": ["./acryl-db/src/conformance.ts"],
      "acryl-db-sqlite": ["./acryl-db-sqlite/src/index.ts"],
      "acryl-db-sqlite/open": ["./acryl-db-sqlite/src/open.ts"],
      "acryl-door": ["./acryl-door/src/index.ts"],
      "acryl-inspect": ["./acryl-inspect/src/index.ts"],
      "acryl-kv": ["./acryl-kv/src/index.ts"],
      "acryl-kv/cordis": ["./acryl-kv/src/cordis.ts"],
      "acryl-kv/conformance": ["./acryl-kv/src/conformance.ts"],
      "acryl-kv-db": ["./acryl-kv-db/src/index.ts"],
      "acryl-kv-db/open": ["./acryl-kv-db/src/open.ts"],
      "acryl-kv-json": ["./acryl-kv-json/src/index.ts"],
      "acryl-kv-json/open": ["./acryl-kv-json/src/open.ts"],
      "acryl-node-server": ["./acryl-node-server/src/index.ts"],
      "acryl-node-server/client-modules": ["./acryl-node-server/src/client-modules.ts"],
      "acryl-router": ["./acryl-router/src/index.ts"],
      "acryl-router/middleware": ["./acryl-router/src/middleware/index.ts"],
      "acryl-router/helpers": ["./acryl-router/src/helpers/index.ts"],
      "acryl-router/client": ["./acryl-router/src/client.ts"],
      "acryl-router/jsx": ["./acryl-router/src/core/jsx/index.ts"],
      "acryl-router/jsx/jsx-runtime": ["./acryl-router/src/core/jsx/jsx-runtime.ts"],
      "acryl-router/jsx/jsx-dev-runtime": ["./acryl-router/src/core/jsx/jsx-dev-runtime.ts"],
      "acryl-router/jsx/streaming": ["./acryl-router/src/core/jsx/streaming.ts"],
      "acryl-router-http": ["./acryl-router-http/src/index.ts"],
      "acryl-state": ["./acryl-state/src/index.ts"],
      "acryl-state/react": ["./acryl-state/src/react.ts"]
    }
  },
  "include": ["*/**/*.ts"],
  "exclude": [
    "acryl-*/**",
    "desktop/main.ts",
    "desktop/window.ts",
    "desktop-web/main.ts",
    "desktop-web/window.ts"
  ]
}
