{
  "name": "acryl-loopback-http",
  "version": "0.1.0",
  "description": "The one strict same-origin loopback check and JSON helpers behind every private ACRYL Host route (workspace, Agent Control, plugin administration, Desktop), on node:http and on the framework's router",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acrylblends/acrylblends.git",
    "directory": "ide/acryl-loopback-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./router": {
      "types": "./lib/types/router.d.ts",
      "default": "./lib/router.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run check",
    "prepublishOnly": "pnpm run check"
  },
  "peerDependencies": {
    "acrylblends": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "acrylblends": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
