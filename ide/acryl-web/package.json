{
  "name": "acryl-web",
  "version": "0.1.0",
  "description": "The acrylWeb service for the IDE port: where the carrier serves the page (DSH's webServer today), so ACRYL's plugins can check the loopback address without injecting a harness service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acrylblends/acrylblends.git",
    "directory": "ide/acryl-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/**",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "acryl-control": "workspace:*"
  }
}
