{
  "name": "acrylblends-monorepo",
  "private": true,
  "type": "module",
  "description": "ACRYLBLENDS - scaffold apps built on Cordis. Cordis is the framework.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p plugins/tsconfig.json",
    "test": "vitest run && node --test \"plugins/*/test/*.test.ts\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify:scaffolder": "node scripts/verify-scaffolder.mjs",
    "check": "pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test && pnpm run verify:scaffolder",
    "verify:model": "node scripts/verify-real-model.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "@webboxes/app-persistence": "0.1.0",
    "@webboxes/blends-core": "0.4.0",
    "ajv": "^8.20.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.0"
  }
}
