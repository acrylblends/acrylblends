{
  "name": "acrylblends-monorepo",
  "private": true,
  "type": "module",
  "description": "ACRYLBLENDS - scaffold apps built on Cordis. Cordis is the framework.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r run build && node scripts/stage-framework.mjs",
    "test:driver-pty": "node --import ./scripts/workspace-source.mjs --test --test-timeout=60000 \"plugins/driver-pty/test/*.test.ts\"",
    "test:packages": "pnpm -r --filter './plugins/acryl-*' --filter acrylblends-framework --filter './ide/*' run test",
    "typecheck": "tsc -p tsconfig.json && tsc -p plugins/tsconfig.json && tsc -p ide/tsconfig.json",
    "test": "vitest run && pnpm run test:packages && node --import ./scripts/workspace-source.mjs --test \"plugins/*/test/*.test.ts\" && node --test scripts/lib/*.test.mjs workshop-registry/test/*.test.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify:scaffolder": "node scripts/verify-scaffolder.mjs",
    "verify:ide-profile": "node --import ./scripts/workspace-source.mjs scripts/verify-ide-profile.mjs",
    "check": "pnpm run lint && pnpm run build && pnpm run verify:framework && pnpm run verify:secrets && pnpm run typecheck && pnpm run test && pnpm run verify:scaffolder && pnpm run verify:ide-profile && pnpm run verify:byo && pnpm run verify:panel && pnpm run verify:door && pnpm run verify:dev-install && pnpm run verify:production && pnpm run verify:driver-pty && pnpm run verify:packed && pnpm run verify:tarball && pnpm run verify:vitest-peer",
    "verify:model": "node scripts/verify-real-model.mjs",
    "verify:framework": "node scripts/stage-framework.mjs --check",
    "verify:secrets": "node scripts/verify-docs-secrets.mjs",
    "verify:driver-pty": "node scripts/verify-driver-pty.mjs",
    "verify:byo": "node scripts/verify-byo-tool.mjs",
    "verify:panel": "node scripts/verify-agent-panel.mjs",
    "verify:door": "node scripts/verify-door-reload.mjs",
    "verify:dev-install": "node scripts/verify-dev-install.mjs",
    "verify:desktop": "node scripts/verify-desktop-door.mjs",
    "verify:production": "node scripts/verify-production-extension.mjs",
    "verify:vitest-peer": "node scripts/verify-vitest-peer.mjs",
    "verify:create": "node scripts/verify-create-npm.mjs",
    "verify:packed": "node scripts/verify-packed.mjs",
    "verify:tarball": "node scripts/verify-tarball.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "@webboxes/app-persistence": "0.1.1",
    "@webboxes/blends-core": "0.4.0",
    "@whatwg-node/fetch": "0.9.23",
    "ajv": "^8.20.0",
    "msw": "2.15.0",
    "node-pty": "1.2.0-beta.15",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "zod": "3.25.76"
  }
}
