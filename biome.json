{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!.specify",
      "!.claude",
      "!**/*.md",
      "!plugins/acryl-*/src",
      "!plugins/acryl-*/tests",
      "!plugins/acryl-*/upstream.json",
      "!docs/framework/upstream.json",
      "!packages/cli/lib",
      "!packages/cli/templates/todo/src/todo.ts",
      "!packages/cli/templates/todo/src/page.ts",
      "!packages/cli/templates/todo/upstream.json",
      "!packages/cli/upstream.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
