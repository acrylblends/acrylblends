{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!.specify",
      "!.claude",
      "!**/*.md",
      "!plugins/acryl-*",
      "!ide/*",
      "!spikes/ide-slice0/dsh-client-ui-brand-acryl",
      "!plugins/driver-pty/client/vendor",
      "!plugins/driver-acp/test/acp-v1",
      "!packages/framework",
      "!packages/cli/lib",
      "!packages/cli/legacy",
      "!packages/cli/templates/todo/src/todo.ts",
      "!packages/cli/templates/todo/src/page.ts",
      "!plugins/desktop/user-data.ts",
      "!plugins/desktop/shutdown.ts",
      "!plugins/desktop-web/user-data.ts",
      "!plugins/desktop-web/shutdown.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
