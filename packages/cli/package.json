{
  "name": "acrylblends",
  "version": "0.2.0",
  "description": "Scaffold Cordis apps: acrylblends init.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "acrylblends": "./bin/acrylblends.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acrylblends/acrylblends.git",
    "directory": "packages/cli"
  },
  "homepage": "https://acrylblends.github.io",
  "keywords": [
    "cordis",
    "scaffold"
  ],
  "private": true,
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4"
  }
}
