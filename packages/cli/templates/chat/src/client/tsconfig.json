{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "acrylblends/jsx/dom",
    "types": [],
    "paths": {
      "acrylblends/jsx/dom": ["../../plugins/acryl-router/src/browser/jsx-dom.ts"],
      "acrylblends/jsx/dom/jsx-runtime": [
        "../../plugins/acryl-router/src/core/jsx/dom/jsx-runtime.ts"
      ],
      "acrylblends/jsx/dom/jsx-dev-runtime": [
        "../../plugins/acryl-router/src/core/jsx/dom/jsx-dev-runtime.ts"
      ],
      "acrylblends/jsx/dom/client": ["../../plugins/acryl-router/src/browser/jsx-dom.ts"],
      "acrylblends/client": ["../../plugins/acryl-router/src/browser/client.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
