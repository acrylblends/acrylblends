{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "acryl-router": ["./src/plugins/acryl-router/src/index.ts"],
      "acryl-router/middleware": ["./src/plugins/acryl-router/src/middleware/index.ts"],
      "acryl-router/helpers": ["./src/plugins/acryl-router/src/helpers/index.ts"]
    }
  },
  "include": ["src", "test", "extensions"]
}
