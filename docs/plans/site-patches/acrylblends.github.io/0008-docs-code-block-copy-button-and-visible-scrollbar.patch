From a2bb50a5cab8e3e4405ba8fb912bcc2745602956 Mon Sep 17 00:00:00 2001
From: Alex Musichen <alex.musichen@gmail.com>
Date: Thu, 29 Oct 2026 01:38:18 +0100
Subject: [PATCH] feat(docs): every code block gets a copy button, and its
 scrollbar is visible

A reader on the workshop page could not see that the long registry command continued past the block's edge: the block scrolls, but the theme's
overlay scrollbar only appears while scrolling. And there was no way to copy a command without selecting it by hand.

- The markdown renderer wraps every <pre> in a `.md-code` container with a copy button: it copies the block's exact textContent (no prompt characters),
  shows "Copied" for 1.5 s, and falls back to selecting the block and document.execCommand('copy') when navigator.clipboard is refused (an insecure
  context, or a browser setting).
- The scrollbar is now thin and visible on both themes: `scrollbar-width: thin` and `scrollbar-color: var(--code-muted) transparent`, with the
  webkit pseudo-elements styled so Chrome and Safari draw a classic thin bar rather than an overlay.
- The button sits inside the block's top-right corner, subtly (opacity .65), and comes to full opacity on hover or keyboard focus.

Checked in a headless browser without --hide-scrollbars at 1280 px and 400 px, in both themes: the long command's block has scrollWidth 988 against
clientWidth 766 (1280) and 358 (400), the document itself never scrolls sideways, the thin scrollbar is visible in light and dark, and clicking the
button copies the whole command (read back from the clipboard and compared with the block, at both widths).
---
 src/components/markdown.tsx | 31 +++++++++++++++++++++++++++++++
 src/styles.css              |  2 +-
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/src/components/markdown.tsx b/src/components/markdown.tsx
index ec04979..4f6babe 100644
--- a/src/components/markdown.tsx
+++ b/src/components/markdown.tsx
@@ -1,12 +1,43 @@
+import { Check, Copy } from "lucide-react";
+import { useRef, useState, type HTMLAttributes } from "react";
 import { Link } from "react-router-dom";
 import ReactMarkdown from "react-markdown";
 import rehypeHighlight from "rehype-highlight";
 import remarkGfm from "remark-gfm";
 import { resolveLink } from "../lib/framework-docs";
 
+/** A code block with a copy button: the exact text of the block, and "Copied" for a moment. */
+function DocsPre({ node, children, ...props }: HTMLAttributes<HTMLPreElement> & { node?: unknown }) {
+  const ref = useRef<HTMLPreElement>(null);
+  const [copied, setCopied] = useState(false);
+  const flash = () => { setCopied(true); window.setTimeout(() => setCopied(false), 1500); };
+  const copy = async () => {
+    const text = ref.current?.textContent ?? "";
+    try {
+      await navigator.clipboard.writeText(text);
+    } catch {
+      // The clipboard is refused (an insecure context, or a browser setting): select the block and copy that.
+      const range = document.createRange();
+      if (ref.current) range.selectNodeContents(ref.current);
+      const selection = window.getSelection();
+      selection?.removeAllRanges();
+      selection?.addRange(range);
+      document.execCommand("copy");
+    }
+    flash();
+  };
+  return <div className="md-code">
+    <button type="button" className="md-code-copy" aria-label="Copy this code" onClick={copy}>
+      {copied ? <><Check size={12}/> Copied</> : <><Copy size={12}/> Copy</>}
+    </button>
+    <pre ref={ref} {...props}>{children}</pre>
+  </div>;
+}
+
 /** One page of markdown, with links between pages resolved to site routes and code highlighted. */
 export function Markdown({ pageKey, children }: { pageKey: string; children: string }) {
   return <div className="md-doc"><ReactMarkdown remarkPlugins={[remarkGfm]} rehypePlugins={[[rehypeHighlight, { detect: false, ignoreMissing: true }]]} components={{
+    pre: (props) => <DocsPre {...props} />,
     a({ href = "", children: label }) {
       const target = resolveLink(pageKey, href);
       if (target.external) return <a href={target.href} target="_blank" rel="noreferrer">{label}</a>;
