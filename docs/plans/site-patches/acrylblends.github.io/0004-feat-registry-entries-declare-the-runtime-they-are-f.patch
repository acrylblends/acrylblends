index a2a6780..acfb2b6 100644
--- a/registry/README.md
+++ b/registry/README.md
@@ -1,21 +1,39 @@
-# The ACRYL Blends registry
+# The Blends registry
 
-Starting points for apps built on ACRYL Blends: **Blank** (the empty house with the builder inside) and **Blueprints** (starter kits specialized enough to start
-from). A project started from any of them is its owner's, in their own repository.
+Starting points other people published. Each entry is a folder under `blends/<id>/`, and `index.json` lists them all with the **runtime** each one is for:
+
+| Runtime | What the entry is | How to start from it |
+| --- | --- | --- |
+| `acrylblends` | A whole app for the `acrylblends` framework: `blend.yaml`, `plugins/`, `src/`, `package.json`, `README.md`, and an `acryl.template.json`. | `npm create acrylblends@latest my-app -- --from <id>` |
+| `acryl` | A starter for the ACRYL app (a Blueprint whose rows are ACRYL plugins). It runs only inside ACRYL. | Open it in the ACRYL app (<https://acryl.dev>). `create-acrylblends` refuses it with one line saying so. |
+
+A project started from any of them is its owner's, in their own repository: the new app is private, named after its folder, and carries none of the starter's id or licence.
 
 ```bash
-acryl new my-app --from <id>        # e.g. acryl.organizer
+npm create acrylblends@latest my-notes -- --from acrylblends.notes-desktop    # npm needs the -- before the options
+cd my-notes && npm install && npm run dev
 ```
 
-## Publish a starter
+`--registry github:owner/repo` (or a folder) reads another registry with this same layout, a team's or a workshop's.
+
+## Publish a starter for acrylblends
+
+Open a pull request that adds `blends/<id>/`, where `<id>` is a dotted id you own (`yourlogin.thing`). The folder is your app as it stands, without `node_modules/`, `dist/`, `data/`, and without `docs/framework/` (create adds those back):
+
+- `blend.yaml`: `kind: Blueprint`, and in `metadata` the `id` (the same as the folder name), `name`, `version`, `license` (an SPDX id), `visibility: public`, a `category` and a one-line `description`. Your app made by `acrylblends init` has `visibility: private` and no licence; change them in the entry, not in your own app.
+- `acryl.template.json`: `{ "name": "...", "description": "...", "plugins": [] }`. **This file is what marks the entry as an app for acrylblends.** `plugins` lists library plugins the app still needs (added with `npx acrylblends add`); an app that carries its `plugins/` folder lists none.
+- `package.json` (its dependencies come with the starter, a desktop starter brings `electron`), `src/`, `plugins/`, `gitignore` (named without the dot), `README.md`: what it is and how to start from it.
+
+CI refuses an entry that: is private or has no licence; lives in another folder than its id; repeats an id; has an `acryl.template.json` that is not valid or an app without `package.json` or `src/`; defines an install script (`preinstall`, `install`, `postinstall`, `prepare`, ...); holds a link, a `node_modules/` or `.git/`; is over 20 MB or 5000 files; or holds what looks like a key. It also makes the app with `create-acrylblends` (nothing is installed or run) and fails when `index.json` is not what `scripts/registry-index.ts` writes: run `bun scripts/registry-index.ts registry` after adding your folder.
+
+## Publish a starter for the ACRYL app
+
+`blends/<id>/` with `blend.yaml` (`kind: Blueprint`, `spec.extends` naming the Blueprint it grew from, usually `acryl.blank`), `plugins/` (the plugins it adds, source, no `node_modules`) and `README.md`. No `acryl.template.json`: that is what makes the entry `runtime: acryl`. People start from it in the ACRYL app.
+
+## Keeping a starter private
 
-Open a pull request that adds `blends/<id>/`:
+Needs no registry at all: people start from its git repository (`npm create acrylblends@latest my-app -- --from github:you/starter`, a repository with an `acryl.template.json`). A company's own registry is this same layout in its own repository: `--registry github:company/registry`.
 
-- `blend.yaml`: `kind: Blueprint`, `spec.extends` naming the Blueprint it grew from (usually `acryl.blank`), and in `metadata`: an id you own (`yourname.thing`),
-  `license`, `visibility: public`, a `category` and a one-line `description`.
-- `plugins/`: the plugins it adds (source, no `node_modules`).
-- `README.md`: what it is and how to start from it.
+## The files
 
-CI validates every entry with `@acryl/blends-core` and fails when `index.json` is stale; run the index tool locally to regenerate it. A private or unlicensed entry
-is refused. Keeping a starter private needs no registry at all: people start from its git repository (`acryl new my-app --from git@host:you/starter.git`).
-A company's private registry is this same layout in its own repository.
+`index.json` is written by `scripts/registry-index.ts`: [`@acryl/blends-core`](https://github.com/acryldev/acryl/tree/main/runtime/blends-core)'s index (validation of every `blend.yaml`) plus the `runtime` of each entry. It is served as it is at <https://acrylblends.github.io/registry/index.json>.
diff --git a/scripts/registry-index.ts b/scripts/registry-index.ts
new file mode 100644
index 0000000..0c7b73c
--- /dev/null
+++ b/scripts/registry-index.ts
@@ -0,0 +1,113 @@
+#!/usr/bin/env bun
+// registry-index <registry folder> [--check]
+// What the registry's CI runs. It is @acryl/blends-core's index tool (validate every starter under blends/<id>/blend.yaml, refuse a private, unlicensed, misplaced or repeated one,
+// write index.json) plus one thing the format does not carry: the runtime an entry is for.
+//   - An entry with an `acryl.template.json` is a whole app for acrylblends (`runtime: acrylblends`): `npm create acrylblends@latest my-app -- --from <id>` makes it. It is checked
+//     further: the template manifest, a package.json without install scripts, src/, no links, no node_modules or .git, size limits, and nothing that looks like a key.
+//   - Every other entry is a starter for the ACRYL app (`runtime: acryl`).
+// With --check nothing is written and a stale index fails. BLENDS_CORE points at blends-core's src (CI checks it out into .acryl/).
+import { existsSync, lstatSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const core = process.env.BLENDS_CORE ?? join(here, "..", ".acryl", "runtime", "blends-core", "src");
+const { buildRegistryIndex } = (await import(join(core, "registry.ts"))) as {
+  buildRegistryIndex(sources: { path: string; manifestText: string }[]): { index: { formatVersion: number; entries: Record<string, unknown>[] }; problems: { path: string; message: string }[] };
+};
+
+const MARKER = "acryl.template.json";
+const LIMITS = { files: 5000, bytes: 20 * 1024 * 1024 };
+const LIFECYCLE = ["preinstall", "install", "postinstall", "prepublish", "preprepare", "prepare", "postprepare"];
+const SECRETS: [RegExp, string][] = [
+  [/-----BEGIN [A-Z ]*PRIVATE KEY-----/, "a private key"],
+  [/\bsk-[A-Za-z0-9_-]{24,}/, "an API key (sk-...)"],
+  [/\bgh[pousr]_[A-Za-z0-9]{30,}/, "a GitHub token"],
+  [/\bAKIA[0-9A-Z]{16}\b/, "an AWS access key"],
+  [/\bnpm_[A-Za-z0-9]{30,}/, "an npm token"],
+];
+
+/** Everything wrong with an app entry; empty when it is a sound starter for acrylblends. */
+function checkApp(dir: string): string[] {
+  const problems: string[] = [];
+  let files = 0;
+  let bytes = 0;
+  const walk = (folder: string) => {
+    for (const name of readdirSync(folder)) {
+      const path = join(folder, name);
+      const info = lstatSync(path);
+      const rel = path.slice(dir.length + 1);
+      if (info.isSymbolicLink()) problems.push(`${rel} is a link; links are not allowed`);
+      else if (info.isDirectory()) {
+        if (name === "node_modules" || name === ".git") problems.push(`${rel} must not be in an entry`);
+        else walk(path);
+      } else {
+        files += 1;
+        bytes += info.size;
+        if (info.size < 1024 * 1024 && !/\.(png|jpe?g|gif|ico|woff2?|tgz|gz|zip)$/i.test(name)) {
+          const text = readFileSync(path, "utf8");
+          for (const [pattern, what] of SECRETS) if (pattern.test(text)) problems.push(`${rel} looks like it holds ${what}`);
+        }
+      }
+    }
+  };
+  walk(dir);
+  if (files > LIMITS.files) problems.push(`has ${files} files; the limit is ${LIMITS.files}`);
+  if (bytes > LIMITS.bytes) problems.push(`is ${Math.round(bytes / 1024 / 1024)} MB; the limit is ${LIMITS.bytes / 1024 / 1024} MB`);
+  try {
+    const manifest = JSON.parse(readFileSync(join(dir, MARKER), "utf8")) as Record<string, unknown>;
+    if (typeof manifest.name !== "string" || manifest.name.trim() === "") problems.push(`${MARKER} needs a "name"`);
+    if (typeof manifest.description !== "string") problems.push(`${MARKER} needs a "description"`);
+    const plugins = manifest.plugins ?? [];
+    if (!Array.isArray(plugins) || plugins.some(p => typeof p !== "string" || !/^[a-z][a-z0-9-]*$/.test(p))) problems.push(`"plugins" in ${MARKER} is a list of plugin names`);
+  } catch {
+    problems.push(`${MARKER} is not valid JSON`);
+  }
+  if (!existsSync(join(dir, "package.json"))) problems.push("has no package.json");
+  else {
+    try {
+      const pkg = JSON.parse(readFileSync(join(dir, "package.json"), "utf8")) as { scripts?: Record<string, string> };
+      for (const script of LIFECYCLE) if (typeof pkg.scripts?.[script] === "string") problems.push(`package.json defines the install script "${script}"; a registry entry may not`);
+    } catch {
+      problems.push("package.json is not valid JSON");
+    }
+  }
+  if (!existsSync(join(dir, "src"))) problems.push("has no src/ folder");
+  return problems;
+}
+
+export function indexText(root: string): { text: string; problems: string[] } {
+  const blends = join(root, "blends");
+  const folders = existsSync(blends) ? readdirSync(blends, { withFileTypes: true }).filter(e => e.isDirectory() && existsSync(join(blends, e.name, "blend.yaml"))) : [];
+  const { index, problems } = buildRegistryIndex(folders.map(e => ({ path: `blends/${e.name}`, manifestText: readFileSync(join(blends, e.name, "blend.yaml"), "utf8") })));
+  const out = problems.map(p => `${p.path}: ${p.message}`);
+  const entries = index.entries.map(entry => {
+    const dir = join(root, String(entry.path));
+    if (!existsSync(join(dir, MARKER))) return { ...entry, runtime: "acryl" };
+    const apps = checkApp(dir);
+    out.push(...apps.map(message => `${String(entry.path)}: ${message}`));
+    return { ...entry, runtime: "acrylblends" };
+  });
+  return { text: `${JSON.stringify({ ...index, entries }, null, 2)}\n`, problems: out };
+}
+
+const argv = process.argv.slice(2);
+const positional = argv.filter(arg => !arg.startsWith("--"));
+if (positional.length !== 1) {
+  console.log("usage: bun scripts/registry-index.ts <registry folder> [--check]");
+  process.exit(2);
+}
+const root = resolve(positional[0] as string);
+const { text, problems } = indexText(root);
+for (const problem of problems) console.log(`refused ${problem}`);
+const file = join(root, "index.json");
+if (argv.includes("--check")) {
+  if ((existsSync(file) ? readFileSync(file, "utf8") : "") !== text) {
+    console.log(`${file} is stale: run bun scripts/registry-index.ts ${positional[0]}`);
+    process.exit(1);
+  }
+} else {
+  writeFileSync(file, text);
+  console.log(`wrote ${file}`);
+}
+process.exit(problems.length > 0 ? 1 : 0);
