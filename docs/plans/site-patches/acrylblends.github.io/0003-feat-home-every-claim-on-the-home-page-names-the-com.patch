+// The two snippets are the real thing: a plugin a generated app can carry, and the blend.yaml of the blank template.
+const pluginCode = `import type { Context } from '@deepseek-ai/cordis'
+import { Acryl } from 'acrylblends'
+
+export const name = 'hello'
+export const inject = ['router']
+
+export function apply(ctx: Context) {
+  const app = new Acryl().get('/hello/:who', (c) => c.json({ hello: c.req.param('who') }))
+  ctx.router.route('/', app)
+}`;
